package main

import (
	"fmt"

	cobrahelptree "github.com/alexgorbatchev/cobra-help-tree/v4"
	"github.com/spf13/cobra"
)

func newRootCommand() *cobra.Command {
	rootCmd := &cobra.Command{
		Use:           "{{.Binary}}",
		Short:         "{{.Description}}",
		Long:          "{{.Description}}.",
		Version:       currentVersion(),
		SilenceUsage:  true,
		SilenceErrors: true,
		Args:          cobra.NoArgs,
		RunE: func(cmd *cobra.Command, args []string) error {
			return cmd.Help()
		},
	}

	rootCmd.SetVersionTemplate("{{ "{{" }}.Version{{ "}}" }}\n")

	rootCmd.AddCommand(newStatusCommand())

	setupHelp(rootCmd)

	return rootCmd
}

func newStatusCommand() *cobra.Command {
	cmd := &cobra.Command{
		Use:   "status",
		Short: "Display system and environment status",
		Long:  "Inspects and outputs the current system and runtime status.",
		Args:  cobra.NoArgs,
		RunE: func(cmd *cobra.Command, args []string) error {
			if cobrahelptree.IsAgentMode() {
				fmt.Fprintln(cmd.OutOrStdout(), "status: ready")
				fmt.Fprintln(cmd.OutOrStdout(), "version: "+currentVersion())
				return nil
			}

			fmt.Fprintln(cmd.OutOrStdout(), "[OK] System status: ready")
			fmt.Fprintln(cmd.OutOrStdout(), "Version: "+currentVersion())
			return nil
		},
	}
	return cmd
}
