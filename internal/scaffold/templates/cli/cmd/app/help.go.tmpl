package main

import (
	cobrahelptree "github.com/alexgorbatchev/cobra-help-tree/v4"
	"github.com/spf13/cobra"
)

const (
	skillRepository = "{{.Repository}}"
	skillBranch     = "main"
)

var techCatalog = cobrahelptree.TechCatalog{
	"{{.Binary}}": {
		Summary:     "{{.Description}}",
		Description: "{{.Description}} - command-line interface.",
	},
	"{{.Binary}} status": {
		Summary:     "Display system and environment status",
		Description: "Outputs current runtime readiness and version information.",
	},
}

// helpWriteError keeps a failed help write for run, because cobra's help
// function cannot return an error.
var helpWriteError error

func setupHelp(cmd *cobra.Command) {
	cobra.CheckErr(cobrahelptree.SetupWithOptions(cmd, cobrahelptree.HelpOptions{
		Catalog: techCatalog,
		Skill:   cobrahelptree.SkillSource{Repository: skillRepository, Branch: skillBranch},
		Tree:    cobrahelptree.TreeOptions{HideGeneratedCommands: true},
		OnHelpWriteError: func(_ *cobra.Command, err error) {
			helpWriteError = err
		},
	}))
}
